# NumeriX Financial Calculator — Environment Configuration (v2.3.2)
# Fully air-gapped, offline, and self-hosted

# Server Port and Host
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
TZ=Asia/Tehran

# Persistent Storage Root Directory (Mounted via ./data:/app/data)
DATA_DIR=/app/data

# Administrative Credentials & Security Fallbacks
RESET_ADMIN_PASSWORD=false
JWT_SECRET=fallback-production-jwt-secret-replace-me
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=123
